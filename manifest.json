{
  "manifest_version": 3,
  "name": "AI Chat Downloader - Export ChatGPT, Claude, Gemini Chats",
  "version": "0.2.0",
  "description": "Save the AI chat on screen as Markdown, text, Word, or PDF. Works on ChatGPT, Claude, Gemini, DeepSeek, Qwen, Kimi. No tracking.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://kimi.moonshot.cn/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "AI Chat Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*"
      ],
      "js": [
        "src/core/namespace.js",
        "src/core/chat.js",
        "src/core/filename.js",
        "src/core/dom.js",
        "src/core/merge.js",
        "src/core/walker.js",
        "src/core/sites.js",
        "src/adapters/chatgpt.js",
        "src/adapters/claude.js",
        "src/adapters/gemini.js",
        "src/adapters/deepseek.js",
        "src/adapters/qwen.js",
        "src/adapters/kimi.js",
        "src/adapters/index.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
